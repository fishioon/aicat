+func newWebSocketData(opts *Options) *WebSocketData {
+	count, size := opts.WebSocketMaxMessages, opts.WebSocketMaxBytes
+	if count == 0 {
+		count = 256
+	}
+	if size == 0 {
+		size = 1 << 20
+	}
+	return &WebSocketData{maxMessages: count, maxBytes: size}
+}
+
+func (wsData *WebSocketData) addMessage(msg *WebSocketMessage) {
+	wsData.mu.Lock()
+	defer wsData.mu.Unlock()
+	wsData.total++
 	wsData.Messages = append(wsData.Messages, msg)
+}
+
+func (wsData *WebSocketData) trim() {
+	wsData.mu.Lock()
+	defer wsData.mu.Unlock()
+	count, size := 0, 0
+	for i := len(wsData.Messages) - 1; i >= 0; i-- {
+		msg := wsData.Messages[i]
+		if wsData.maxMessages < 0 || wsData.maxBytes < 0 || count >= wsData.maxMessages || len(msg.Content) > wsData.maxBytes-size {
+			for j := 0; j <= i; j++ {
+				wsData.Messages[j] = nil
+			}
+			wsData.Messages = wsData.Messages[i+1:]
+			break
+		}
+		count++
+		size += len(msg.Content)
+	}
+	retained := make([]*WebSocketMessage, len(wsData.Messages))
+	copy(retained, wsData.Messages)
+	wsData.Messages = retained
+}
+
+func (wsData *WebSocketData) Snapshot() []*WebSocketMessage {
+	wsData.mu.Lock()
+	defer wsData.mu.Unlock()
+	out := make([]*WebSocketMessage, len(wsData.Messages))
+	for i, msg := range wsData.Messages {
+		value := *msg
+		value.Content = append([]byte(nil), msg.Content...)
+		out[i] = &value
+	}
+	return out
+}
+
+func (wsData *WebSocketData) MessageCount() uint64 {
+	wsData.mu.Lock()
+	defer wsData.mu.Unlock()
+	return wsData.total
 }
 
