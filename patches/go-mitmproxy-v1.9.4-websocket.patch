+func (h *webSocketHandler) notifyMessage(f *Flow, msg *WebSocketMessage) {
+	data := f.WebSocket
+	data.dispatchMu.Lock()
+	defer data.dispatchMu.Unlock()
+	data.addMessage(msg)
+	defer data.trim()
+	for _, addon := range h.proxy.Addons {
+		if observer, ok := addon.(WebSocketMessageObserver); ok {
+			observer.WebSocketMessageReceived(f, msg)
+		} else {
+			addon.WebSocketMessage(f)
+		}
+	}
